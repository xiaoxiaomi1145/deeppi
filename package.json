{
  "name": "deeppi",
  "version": "2.1.0",
  "description": "A local Web companion for Pi's native coding-agent sessions",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "web"
  ],
  "files": [
    "extensions",
    "server",
    "dist",
    "docs",
    "web/UPSTREAM.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES"
  ],
  "pi": {
    "extensions": [
      "./extensions/deeppi.ts"
    ]
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "deeppi-web": "server/pi-web/index.mjs"
  },
  "scripts": {
    "pi-web": "node server/pi-web/index.mjs",
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "test": "node --test",
    "check": "tsc --noEmit",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.6.0",
    "ws": "8.22.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "22.19.19",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3"
  }
}
